# Copy to .env — the ONLY env file the app reads. Never commit .env.
# Keep comments on their own lines: "KEY=   # note" makes the note the value.
# On Cloud Run the secrets come from Secret Manager instead.

GEMINI_API_KEY=

# vobiz | twilio (outbound calling is implemented for Vobiz)
TELEPHONY_PROVIDER=vobiz

# Vobiz console dashboard: Auth ID and Auth Token
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Caller ID: a Vobiz India number on this account, digits only, e.g. 918065481243
VOBIZ_FROM_NUMBER=
RING_SECS=45

# https://<service>.run.app or your ngrok URL, no trailing slash.
# Optional on Cloud Run: derived from the request when empty.
PUBLIC_URL=

# Private bucket for pending call requests (resume text, deleted after the call)
SESSIONS_BUCKET=
CALL_COOLDOWN_SECS=300
MAX_CALLS_PER_DAY=3

# Sheet shared as Editor with the runtime service account
GOOGLE_SPREADSHEET_ID=
CALL_LOG_TAB=Call_Logs

# Optional service-account key JSON. Leave unset on Cloud Run (keyless ADC).
GOOGLE_CREDENTIALS=

# Summary email to the user. App password needs 2-Step Verification.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Seconds before the coach is told to recap, and the hard call limit
WRAP_UP_SECS=660
MAX_CALL_SECS=840
