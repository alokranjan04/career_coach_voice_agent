# Copy to .env — the ONLY env file the app reads. Never commit .env.
# Keep comments on their own lines: "KEY=   # note" makes the note the value.
# On Cloud Run the three secrets come from Secret Manager instead.

GEMINI_API_KEY=

# Sheet shared as Editor with the runtime service account
GOOGLE_SPREADSHEET_ID=
SESSION_LOG_TAB=Session_Logs

# Optional service-account key JSON. Leave unset on Cloud Run (keyless ADC).
GOOGLE_CREDENTIALS=

# Session summary email to the user. App password needs 2-Step Verification.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Seconds before the coach is told to recap, and the hard session limit
WRAP_UP_SECS=660
MAX_SESSION_SECS=840
